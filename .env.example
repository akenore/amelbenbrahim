# Public URL used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.amelbenbrahim.com

# Dashboard access. Generate the secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Where posts, appointment requests and uploaded images are stored.
# Must be a persistent directory in production. Defaults to ./.data
DATA_DIR=
