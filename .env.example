# Public URL used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.amelbenbrahim.com

# Demo or staging copy (e.g. https://demo.amelbenbrahim.com): keep it out of search engines.
# Leave empty on the real site.
# SITE_NOINDEX=true

# PostgreSQL connection (Coolify: the database's "Postgres URL (internal)").
# Local development: `bun run db:local`, then
#   DATABASE_URL=postgres://postgres:postgres@localhost:5433/amelbenbrahim
DATABASE_URL=
# Optional: size of the connection pool (default 10).
# DATABASE_POOL_MAX=10

# Dashboard access. Generate the secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# First login only: creates the first administrator while the database has no account.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# WhatsApp alerts for new appointment requests (WhatsApp Business Cloud API, see README).
# Leave empty to disable the alerts.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional: approved template name and language (defaults: nouvelle_demande_rdv, fr).
# WHATSAPP_TEMPLATE=nouvelle_demande_rdv
# WHATSAPP_TEMPLATE_LANG=fr

# One-time import only: folder of the former JSON store (db.json and uploads/).
# Read on the first start with an empty database, then ignored. Defaults to ./.data
# DATA_DIR=
